{
  "name": "imagine-surrey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ICU_TIMEZONE_FILES_DIR=./tzdata next dev",
    "build": "ICU_TIMEZONE_FILES_DIR=./tzdata next build",
    "vercel-build": "tsx scripts/predeploy.ts && ICU_TIMEZONE_FILES_DIR=./tzdata next build",
    "build:deploy": "tsx scripts/predeploy.ts && ICU_TIMEZONE_FILES_DIR=./tzdata next build",
    "start": "ICU_TIMEZONE_FILES_DIR=./tzdata next start",
    "typecheck": "tsc --noEmit",
    "test": "ICU_TIMEZONE_FILES_DIR=./tzdata vitest run",
    "e2e": "node e2e/run.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "marked": "^18.1.2",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
