# ── Site ────────────────────────────────────────────────────────────────
# Public URL of the site, used for the pages Stripe brings people back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Starbase: the site's backend ───────────────────────────────────────
# Where Starbase runs (its public JSON is read from here, and every form
# posts here) and the campaign's slug there. On Starbase, put this site's
# origin in STARBASE_SITE_ORIGINS so Stripe may return to it.
STARBASE_URL=http://localhost:8787
STARBASE_WORKSPACE=imagine-surrey

# ── Contributions (BC Local Elections Campaign Financing Act) ──────────
# The annual limit the pages quote, in cents. 2026: $1,429.70. Starbase
# checks the real limit on every contribution.
CONTRIBUTION_LIMIT_CENTS=142970
