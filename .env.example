# ── Site ────────────────────────────────────────────────────────────────
# Public URL of the site: Stripe redirects, email links and share images are
# built from it. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (PostgreSQL: Supabase, Neon, RDS, Render, or local) ───────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/imagine_surrey

# ── Stripe ──────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys. Use sk_test_… until you go live.
STRIPE_SECRET_KEY=sk_test_replace_me
# Dashboard → Developers → Webhooks → your endpoint → Signing secret.
# Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── Contributions (BC Local Elections Campaign Financing Act) ──────────
# Annual limit per contributor, per slate, in cents. 2026: $1,429.70.
# Only the fallback for a year with no figure in Admin → Contribution limits.
CONTRIBUTION_LIMIT_CENTS=142970
# Membership is by donation: the minimum a year, in cents. The whole amount
# chosen counts as a contribution. Set to 0 for free membership (no checkout).
MEMBERSHIP_FEE_CENTS=1000
# Optional minimum for youth members (14 to 30). Unset: half of the above.
# MEMBERSHIP_YOUTH_MIN_CENTS=500

# ── Admin ──────────────────────────────────────────────────────────────
# A long random secret that signs admin session cookies: `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=generate-with-openssl-rand-hex-32
# The first owner account. Used only until a staff account exists; after
# that, manage accounts in /admin/users and you can remove these.
ADMIN_EMAIL=you@imaginesurrey.ca
ADMIN_PASSWORD=change-me-to-at-least-12-characters
# Owners and administrators must use two-factor sign-in (an authenticator
# app). 0 turns that off on a development copy only: it is ignored when
# NODE_ENV=production (except under the e2e runner), on Vercel, and when
# RENDER=true, so the live site always requires it. Changing
# ADMIN_SESSION_SECRET invalidates every enrolled authenticator app.
ADMIN_MFA_REQUIRED=

# ── Email (Resend: resend.com) — optional until set ────────────────────
# Without it, nothing is sent; emails are logged as "skipped" in /admin.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM="Imagine Surrey <hello@imaginesurrey.ca>"
EMAIL_REPLY_TO=hello@imaginesurrey.ca

# ── Text messages (Twilio) — optional ───────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio phone number (+1…) or a Messaging Service SID (MG…).
TWILIO_FROM=

# ── Image uploads (Supabase Storage) — optional; local files in development ──
# Required on Vercel and Render: Vercel's disk is read-only and Render wipes
# its disk on every deploy, so uploads are refused there until these are set.
# Project Settings → API. The service role key stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# A public bucket; create it in Storage.
SUPABASE_MEDIA_BUCKET=site-media

# ── Starbase ("the desk"), the campaign's database — optional ──────────
# New sign-ups (petitions, pledges, newsletter, volunteer shifts, memberships,
# deletion requests), portal edits, tags for RSVPs, paid orders and promise
# follows, and every unsubscribe and text STOP are sent to Starbase from this
# server. Money never is: the treasurer logs gifts at the desk.
# The address, with no trailing slash (https:// only).
STARBASE_URL=
# A website key: Starbase → Settings → Services → Website keys → Make a key.
# Secret: server only, never NEXT_PUBLIC_. Without both, nothing is sent and
# sign-ups are kept in the admin as "skipped".
STARBASE_KEY=
# The other direction: the key Starbase sends (Authorization: Bearer …) to
# POST /api/in/consent when someone unsubscribes or texts STOP there. A long
# random secret of your own (e.g. `openssl rand -base64 32`), set here and in
# Starbase. Without it that endpoint refuses every call.
STARBASE_INBOUND_KEY=

# ── Human check on public forms (Cloudflare Turnstile) — set both for live ──
# Cloudflare dashboard → Turnstile → Add widget (mode: Managed). The site key
# is public; the secret key stays on the server. With only one set, it's off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Leave blank for Cloudflare's own address; only tests point it elsewhere.
TURNSTILE_VERIFY_URL=

# ── Scheduled jobs ──────────────────────────────────────────────────────
# Vercel sets this automatically for Cron; locally, leave blank.
CRON_SECRET=

# ── Analytics — optional; one of ─────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Local preview of the admin without a password: 1 signs anyone who opens
# /admin in as an owner. Works only with a database on this machine
# (localhost) and never on Vercel or Render, so it can't reach the live site.
ADMIN_PREVIEW_MODE=
